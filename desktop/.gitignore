# Installed by `pnpm install` here (Electron and its tooling).
/node_modules

# Written by scripts/stage.mjs: the staged copy of the server, the icon it
# copies for electron-builder, and better-sqlite3 binaries built for Electron.
/server
/build/icon.png
/.cache

# Written by electron-builder.
/dist

# Written by scripts/keychain.mjs: the Touch ID keychain module's build, and
# the copy electron-builder packs.
/native/keychain/build
/native-staged

# Written by scripts/dist.mjs from MAC_PROVISIONING_PROFILE.
/build/embedded.provisionprofile
/build/entitlements.keychain.plist
