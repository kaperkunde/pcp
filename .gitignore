/coverage
/e2e/.auth
/e2e/.artifacts
/e2e/.state
/test-results
/playwright-report
/blob-report
/playwright/.cache

# claude code (machine-local)
/.claude/launch.json
/.claude/worktrees/
/.claude/settings.local.json

# Python bytecode (the sandbox tests compile sandbox/*.py)
__pycache__/
