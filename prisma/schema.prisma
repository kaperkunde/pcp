// PCP data model.
//
// Every row that belongs to a person hangs off a Vault. The single-user
// product creates exactly one vault at setup; nothing else in the schema
// assumes that, which is what lets a multi-tenant host reuse it unchanged
// (see ARCHITECTURE.md, "One vault per user").
//
// Nothing sensitive is stored in the clear. Secret values, OAuth tokens and
// the vault's data key itself are AES-256-GCM ciphertext; the key needed to
// read them only ever exists in the memory of a request that presented a
// password, a session cookie or an API token (lib/core/crypto.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vault {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants   KeyGrant[]
  sessions Session[]
  tokens   ApiToken[]
  secrets  Secret[]
  servers  McpServer[]
  settings Setting[]

  permissionRequests PermissionRequest[]
  memories           Memory[]
  skills             Skill[]
  sharedToolAccess   VaultToolAccess[]
  webFetchRules      WebFetchRule[]
  toolResults        ToolResult[]
  callRecords        CallRecord[]
  fileLinks          FileLink[]
  uploadLinks        UploadLink[]
  browserProfile     BrowserProfile?
  oauthCredentials   OAuthCredential[]
  repos              Repo[]
  serverDefinitions  ServerDefinition[]
  exits              Exit[]
  toolTiers          ToolTier[]
  embeddingVectors   EmbeddingVector[]

  @@map("vault")
}

/// A copy of the vault's data encryption key, wrapped under a key derived
/// from one credential. `password` and `recovery` grants are the ones a
/// person types; `session` and `api_token` grants are minted for a browser
/// cookie or a bearer token, and a `device` grant for the Mac app's Touch ID
/// key. Deleting a grant revokes that credential.
model KeyGrant {
  id         String    @id
  vaultId    String    @map("vault_id")
  vault      Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// password | recovery | session | api_token | device, and what PCP's
  /// authorization server hands an assistant: oauth_code | oauth_access |
  /// oauth_refresh
  kind       String
  /// SHA-256 of the credential, for grants looked up by it (everything but
  /// password, of which a vault has exactly one).
  lookupHash String?   @unique @map("lookup_hash")
  /// scrypt | hkdf
  kdf        String
  /// JSON: the salt and, for scrypt, its cost parameters.
  kdfParams  String    @map("kdf_params")
  /// nonce || ciphertext || tag of the wrapped data key.
  wrappedDek Bytes     @map("wrapped_dek")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  session         Session?
  token           ApiToken?
  oauthCredential OAuthCredential?

  @@index([vaultId, kind])
  @@map("key_grant")
}

model Session {
  id         String   @id
  vaultId    String   @map("vault_id")
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  grantId    String   @unique @map("grant_id")
  grant      KeyGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([vaultId])
  @@map("session")
}

/// A bearer token an MCP client presents to /mcp. It reaches the servers
/// listed in ApiTokenServer, or every server when allowAllServers is set,
/// and sees the skills listed in ApiTokenSkill, or every one when allSkills
/// is set.
model ApiToken {
  id               String    @id
  vaultId          String    @map("vault_id")
  vault            Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  grantId          String    @unique @map("grant_id")
  grant            KeyGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// The name from before it was sealed (#96): read only while sealedName
  /// is null, "" once the row is sealed.
  plainName        String    @map("name")
  /// The name the owner gave it: AES-256-GCM under the vault's data key
  /// with "api_token:<id>:name" as associated data (lib/core/token-names.ts).
  sealedName       Bytes?    @map("sealed_name")
  /// The first characters of the token, so the owner can tell them apart.
  prefix           String
  allowAllServers  Boolean   @default(true) @map("allow_all_servers")
  /// Whether the assistant sees every skill of the vault (lib/core/skills.ts)
  /// or only those in ApiTokenSkill. On unless the owner chooses some.
  allSkills        Boolean   @default(true) @map("all_skills")
  /// Whether the assistant may read and change the API endpoints it set up
  /// through the gateway (get_endpoint, update_endpoint). Registering one is
  /// register_server, which every token may ask for and the owner decides.
  /// Off unless the owner turns it on.
  manageEndpoints  Boolean   @default(false) @map("manage_endpoints")
  /// Whether the assistant may keep memories (the gateway's memory tool):
  /// its own, and the shared ones the owner agreed to. Sharing one always
  /// asks the owner. Off unless the owner turns it on.
  keepMemories     Boolean   @default(false) @map("keep_memories")
  /// While on (and keepMemories is), the instructions ask the assistant to
  /// offer to move the memories and skills its client keeps elsewhere into
  /// PCP, asking the owner before it moves them and again before it deletes
  /// the originals. The assistant turns it off when it is done (the memory
  /// tool's migration_done); only the owner turns it on. On for a new token.
  memoryMigration  Boolean   @default(true) @map("memory_migration")
  /// Whether the assistant may fetch web pages through the gateway
  /// (web_fetch), following the token's site and method levels
  /// (WebFetchRule). Off unless the owner turns it on.
  webFetch         Boolean   @default(false) @map("web_fetch")
  /// Whether the assistant may run programs that call its tools through
  /// the gateway (run_code), each call at the token's own levels. Off
  /// unless the owner turns it on.
  runCode          Boolean   @default(false) @map("run_code")
  /// Whether the assistant may propose wrappers (create_wrapper and its
  /// kin, lib/core/wrappers/): servers whose tools are programs over the
  /// owner's other tools. Every change it proposes is the owner's to make.
  /// Off unless the owner turns it on.
  manageWrappers   Boolean   @default(false) @map("manage_wrappers")
  /// Whether the assistant may move files between PCP and its own computer
  /// by link (share_result, receive_file; lib/core/file-links.ts), so a
  /// file's bytes never pass through it. Off unless the owner turns it on.
  shareFiles       Boolean   @default(false) @map("share_files")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  /// Set when the token was made by an assistant signing in with OAuth at
  /// PCP's own authorization server: the client_id it was issued to (a
  /// registered client's id, or the URL of its metadata document) and the
  /// name the client gave. Such a token has no pcp_ value: its grant is
  /// empty, and the key travels in its OAuth credentials.
  oauthClientId    String?   @map("oauth_client_id")
  oauthClientName  String?   @map("oauth_client_name")
  /// The owner's instructions for this assistant, given at the start of
  /// every conversation (lib/core/instructions.ts): ciphertext under the
  /// vault's key with "api_token:<id>" as associated data. Null until the
  /// owner saves some; a new token starts from PCP's suggested ones.
  instructions     Bytes?
  /// The version of PCP's suggested instructions (instructions-defaults.ts)
  /// the text was copied or merged from. Null with no instructions.
  instructionsBase Int?      @map("instructions_base")
  /// The owner's choice of client profile for this token
  /// (lib/core/clients/profiles.ts: what PCP repeats of its instructions in
  /// answers, and how it formats links), by id. Null: detected per request.
  clientProfile    String?   @map("client_profile")
  /// The client PCP last saw use this token, as JSON: its name and version
  /// as the client gave them, the profile it was detected as, and when
  /// (lib/core/clients/detect.ts). Nothing of a request's content, never a
  /// header's value but the client's own label; not the request log.
  clientSeen       String?   @map("client_seen")

  servers            ApiTokenServer[]
  skills             ApiTokenSkill[]
  toolAccess         ApiTokenToolAccess[]
  permissionRequests PermissionRequest[]
  memories           Memory[]
  privateSkills      Skill[]
  webFetchRules      WebFetchRule[]
  toolResults        ToolResult[]
  callRecords        CallRecord[]
  fileLinks          FileLink[]
  uploadLinks        UploadLink[]
  oauthCredentials   OAuthCredential[]
  toolAllowances     ApiTokenToolAllowance[]
  siteAllowances     ApiTokenSiteAllowance[]
  secretAllowances   ApiTokenSecretAllowance[]

  @@index([vaultId])
  @@map("api_token")
}

model ApiTokenServer {
  tokenId  String    @map("token_id")
  token    ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId String    @map("server_id")
  server   McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([tokenId, serverId])
  @@map("api_token_server")
}

/// A skill a token sees while its allSkills is off (the owner chose some).
model ApiTokenSkill {
  tokenId String   @map("token_id")
  token   ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  skillId String   @map("skill_id")
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([tokenId, skillId])
  @@index([skillId])
  @@map("api_token_skill")
}

/// What one token may do with one tool. No row means the tool's level for
/// all tokens (VaultToolAccess), and without one of those the owner is asked
/// first. An `ask` row is only kept while there is a level for all tokens
/// to override. Keyed by tool name, not by the catalogue row, so a tool that
/// drops out of a refresh and comes back keeps its setting.
model ApiTokenToolAccess {
  tokenId   String    @map("token_id")
  token     ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId  String    @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName  String    @map("tool_name")
  /// allowed | ask | blocked
  access    String
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([tokenId, serverId, toolName])
  @@map("api_token_tool_access")
}

/// A tool the owner allowed one token for a while ("Allow for" on a
/// request, lib/core/allowances.ts): until `until`, a call that its level
/// would ask about runs without asking. It changes no level, never lifts
/// a blocked tool, and is not exported.
model ApiTokenToolAllowance {
  tokenId   String    @map("token_id")
  token     ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId  String    @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName  String    @map("tool_name")
  until     DateTime
  createdAt DateTime  @default(now()) @map("created_at")

  @@id([tokenId, serverId, toolName])
  @@index([until])
  @@map("api_token_tool_allowance")
}

/// A site the owner allowed one token for a while, for web fetch and the
/// browser alike: until `until`, a request its levels would ask about goes
/// ahead. Like a tool's, it changes no level and never lifts a block.
model ApiTokenSiteAllowance {
  tokenId   String   @map("token_id")
  token     ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// The site's host as a keyed hash under the vault's key, the host itself
  /// in sealed (#96); a row from before holds the host in plain text here
  /// and no sealed one.
  host      String
  /// The host, AES-256-GCM under the vault's data key with
  /// "api_token_site_allowance:<token id>:<host hash>" as associated data.
  sealed    Bytes?
  until     DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@id([tokenId, host])
  @@index([until])
  @@map("api_token_site_allowance")
}

/// A secret the owner let one token have typed into pages at one origin
/// (lib/core/browser-secrets.ts): for an hour, for one use (`once`), or
/// always (`until` null). Asked for per secret, origin and token on the
/// owner's page; it never lifts a blocked tool, and is not exported.
model ApiTokenSecretAllowance {
  tokenId   String    @map("token_id")
  token     ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  secretId  String    @map("secret_id")
  secret    Secret    @relation(fields: [secretId], references: [id], onDelete: Cascade)
  /// A keyed hash of the origin (https://host[:port], as URL.origin writes
  /// it) under the vault's key, the origin sealed in `sealed`; a row from
  /// before holds the origin itself and nothing sealed
  /// (lib/core/browser-secrets.ts).
  origin    String
  /// The origin, AES-256-GCM under the vault's data key with
  /// "api_token_secret_allowance:<token id>:<secret id>:<origin>" as
  /// associated data.
  sealed    Bytes?
  /// Null: always, until the owner ends it.
  until     DateTime?
  /// The next use only: it goes once a use takes it.
  once      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@id([tokenId, secretId, origin])
  @@index([until])
  @@map("api_token_secret_allowance")
}

/// A tool's level for every token of the vault ("All tokens" on a token's
/// page). A token's own level (ApiTokenToolAccess) wins over it.
model VaultToolAccess {
  vaultId   String    @map("vault_id")
  vault     Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  serverId  String    @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName  String    @map("tool_name")
  /// allowed | ask | blocked
  access    String
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([serverId, toolName])
  @@index([vaultId])
  @@map("vault_tool_access")
}

/// A way out to the internet from somewhere else than PCP's machine
/// (lib/core/exits/): web_fetch and a browser tab can go through one by name.
/// Kind "ssh" leaves from the SSH server itself (direct-tcpip channels);
/// kind "service" from a VPN container PCP runs on one. Only the owner adds,
/// changes or removes one. Its level per token is a web_fetch_rule of kind
/// "exit" keyed by its id: blocked without one.
model Exit {
  id        String     @id
  vaultId   String     @map("vault_id")
  vault     Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// What an assistant calls it, unique in the vault.
  name      String
  /// The owner's words for where it comes out ("US — home VPS"); may be "".
  label     String     @default("")
  /// ssh | service
  kind      String
  /// The SSH server it leaves from, or whose loopback its container is on.
  serverId  String     @map("server_id")
  server    McpServer  @relation("ExitHost", fields: [serverId], references: [id], onDelete: Cascade)
  /// The service (a container PCP runs) for kind "service"; null for "ssh".
  serviceId String?    @map("service_id")
  service   McpServer? @relation("ExitService", fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([vaultId, name])
  @@index([serverId])
  @@index([serviceId])
  @@map("exit")
}

/// A level web_fetch follows (lib/core/web-fetch.ts): for one HTTP method
/// (the default for sites without a level of their own) or for one site,
/// for one token or for all of them. A token's own rule wins over the one
/// for all tokens, and a site's over a method's.
model WebFetchRule {
  id            String    @id
  vaultId       String    @map("vault_id")
  vault         Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The token it is for; null for a rule for all tokens.
  tokenId       String?   @map("token_id")
  token         ApiToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// The token's id, or "all": what makes a rule unique, since SQLite lets
  /// any number of rows share a null token id.
  scope         String
  /// method | site
  kind          String
  /// A method: GET | POST | PUT | PATCH | DELETE | OTHER. A site (and a
  /// script's site): its host, lower-case, with the port when it is not the
  /// scheme's own, kept as a keyed hash of it under the vault's key with the
  /// host in sealed (lib/core/fetch-rule-keys.ts, #96); a row from before
  /// holds the host itself. An exit: its id. private: "private".
  key           String
  /// A site's host, AES-256-GCM under the vault's data key with
  /// "web_fetch_rule:<id>:key" as associated data. Null for other kinds.
  sealed        Bytes?
  /// allowed | ask | blocked. Null on a site: it follows the method rules.
  access        String?
  /// assistant (first seen in a fetch) | owner (added in PCP)
  addedBy       String    @default("assistant") @map("added_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastFetchedAt DateTime? @map("last_fetched_at")

  @@unique([vaultId, scope, kind, key])
  @@index([tokenId])
  @@map("web_fetch_rule")
}

/// A tool call (or a new server) an assistant asked for that waits for the
/// owner's answer (lib/core/permissions.ts). Answerable for a day; it runs at
/// most once, whichever way the owner answers.
model PermissionRequest {
  id                   String     @id
  vaultId              String     @map("vault_id")
  vault                Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId              String     @map("token_id")
  token                ApiToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// call | register | memory_share | memory_change | access | endpoint_change
  /// | fetch | browse | browser_handover | wrapper_change | skill_change
  /// | repo_change | secret_use | secret_request | note_change | repo_share
  kind                 String
  serverId             String?    @map("server_id")
  server               McpServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The upstream tool for a call; "register_server" for a new server;
  /// "memory" for a memory to share or a shared one to change;
  /// "propose_tool_access" for tool levels an assistant proposes;
  /// "web_fetch" for a web request.
  toolName             String     @map("tool_name")
  /// The arguments (or the new server's settings) as JSON, AES-256-GCM under
  /// the vault's data key with "permission_request:<id>" as associated data.
  argsCiphertext       Bytes      @map("args_ciphertext")
  /// HMAC-SHA256 of the kind, the target and the canonical arguments under a
  /// key derived from the vault's data key, prefixed "h1:" (requestHash), so
  /// the same request asked twice finds the row it already has and the
  /// column confirms no guess without the key. Older rows hold a plain
  /// sha256 and match nothing.
  argsHash             String     @map("args_hash")
  /// What the request is about (a skill, a shared memory, a note's item),
  /// as an HMAC under a key derived from the vault's data key, so the target
  /// is never stored in the clear: a second change from the same token to
  /// the same thing folds into the request still waiting, and another
  /// token's is shown as a conflict. Null on rows from before it existed.
  targetKey            String?    @map("target_key")
  /// call: the parts of the answer the assistant asked for (call_tool's
  /// fields), as a JSON list of paths. Names, never values.
  fields               String?
  /// call: where the assistant asked for base64 text in the answer to be
  /// decoded (call_tool's decode), as a JSON list of paths.
  decode               String?
  /// call: the parts of the answer the assistant asked to be kept as results
  /// and handed back as handles (call_tool's keep), as a JSON list of paths.
  keep                 String?
  /// pending | running | executed | failed | declined | withdrawn (the
  /// assistant took it back) | closed (a hand-over's tab closed first)
  status               String     @default("pending")
  /// Where the owner answered: app | form | url | web
  via                  String?
  /// The result text, clipped, encrypted with "permission_request:<id>:result".
  resultCiphertext     Bytes?     @map("result_ciphertext")
  resultIsError        Boolean    @default(false) @map("result_is_error")
  /// call: the answer as a run_code program is handed it (answers.ts
  /// answerValue, files and long texts as handles), as JSON, encrypted with
  /// "permission_request:<id>:result_json". Kept only for a call the owner
  /// allowed once, and only when short enough (REUSE_VALUE_MAX_CHARS).
  resultJsonCiphertext Bytes?     @map("result_json_ciphertext")
  /// call allowed once that ran: until when the same token's identical call
  /// is answered with this run's answer instead of asking again. Cleared
  /// when that happens, so it answers one such call.
  reuseUntil           DateTime?  @map("reuse_until")
  createdAt            DateTime   @default(now()) @map("created_at")
  expiresAt            DateTime   @map("expires_at")
  decidedAt            DateTime?  @map("decided_at")

  @@index([tokenId, argsHash])
  /// The owner's answers to a token's requests since a time
  /// (listAnsweredRequests), looked for on every answer in a session.
  @@index([tokenId, decidedAt])
  @@index([vaultId, targetKey])
  @@index([vaultId, status])
  @@index([expiresAt])
  @@map("permission_request")
}

/// A note an assistant keeps for the owner through the gateway's memory
/// tool (lib/core/memories.ts), or one the owner wrote. `private` ones are
/// read only by the token that wrote them; `shared` ones by every token that
/// may keep memories, and an assistant only shares one once the owner agrees.
model Memory {
  id         String    @id
  vaultId    String    @map("vault_id")
  vault      Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The token that wrote it. Null for the owner's own, and once the token
  /// is deleted: the memory stays, it is the owner's.
  tokenId    String?   @map("token_id")
  token      ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  /// assistant | owner
  author     String    @default("assistant")
  /// private | shared
  visibility String    @default("private")
  /// Read in every conversation: its text goes into the gateway's
  /// instructions. Only the owner sets it, and an assistant's change to one
  /// it keeps clears it (memories.ts).
  always     Boolean   @default(false)
  /// The path and the text as JSON, AES-256-GCM under the vault's data key
  /// with "memory:<id>" as associated data.
  ciphertext Bytes
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([vaultId, visibility])
  @@index([tokenId])
  @@map("memory")
}

/// A procedure the owner approved, for assistants to follow when a task
/// matches (lib/core/skills.ts), in the shape of an Agent Skill's SKILL.md.
/// Written by the owner, or by an assistant through a request they agreed
/// to; the tokens that see it are their allSkills and ApiTokenSkill.
model Skill {
  id           String    @id
  vaultId      String    @map("vault_id")
  vault        Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// owner | assistant: who wrote the text as it is now.
  author       String    @default("owner")
  /// shared | private. A shared skill is seen by the tokens the owner
  /// chooses (allSkills, ApiTokenSkill); a private one only by the token
  /// that keeps it (`tokenId`), which writes it without asking, and by the
  /// owner. A private one is never in a linked repository.
  visibility   String    @default("shared")
  /// The token a private skill is kept by. Null for a shared skill, and for
  /// a private one once its token is deleted: it stays, the owner's alone,
  /// seen by no token.
  tokenId      String?   @map("token_id")
  token        ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  /// The name, description, version, body, tools and files as JSON,
  /// AES-256-GCM under the vault's data key with "skill:<id>" as associated
  /// data. Shared names are unique per vault, a private skill's per token,
  /// by checking, as memory paths are.
  ciphertext   Bytes
  /// The owner's own note on the skill (its one instance), at most 300
  /// characters on one line: AES-256-GCM under the vault's data key with
  /// "skill:<id>:note" as associated data. Assistants that see the skill
  /// read it as the owner's note; it is never synced or shared
  /// (lib/core/definitions.ts).
  personalNote Bytes?    @map("personal_note")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tokens         ApiTokenSkill[]
  repoItems      RepoItem[]
  repoExclusions RepoExclusion[]

  @@index([vaultId])
  @@index([tokenId])
  @@map("skill")
}

/// One encrypted value. `text` and `totp` secrets are entered by the owner
/// (a `totp` one holds a one-time code's seed, base32 or an otpauth:// link);
/// `oauth` secrets hold the token set (and registered client) PCP obtained
/// for an MCP server and are managed by the server that owns them.
model Secret {
  id               String    @id
  vaultId          String    @map("vault_id")
  vault            Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The name and description from before they were sealed (#96): read
  /// only while meta is null, "" once the row is sealed.
  plainName        String    @map("name")
  plainDescription String    @default("") @map("description")
  /// The name and description, as JSON {"name", "description"}: AES-256-GCM
  /// under the vault's data key with "secret:<id>:meta" as associated data
  /// (lib/core/secret-meta.ts). Null on a row from before, until sealed.
  meta             Bytes?
  /// The name, found by: a keyed hash of it under the vault's key
  /// (keyedHash in lib/core/crypto.ts, label "pcp secret name"). Unique in
  /// the vault.
  nameKey          String?   @map("name_key")
  /// text | totp | oauth | ssh_key (PCP's own private key for an SSH server)
  kind             String    @default("text")
  /// nonce || ciphertext || tag, AES-256-GCM under the vault's data key
  /// with the secret id as associated data.
  ciphertext       Bytes
  keyVersion       Int       @default(1) @map("key_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastUsedAt       DateTime? @map("last_used_at")
  /// The owner's login name for the sign-in this secret is the password of
  /// (an email or a user name): not a secret, but theirs, so AES-256-GCM
  /// under the vault's data key with "secret:<id>:login" as associated
  /// data. Shown to assistants with the secret's name (list_secrets, and the
  /// browser's note of the sign-ins at a page's site). Owner's kinds only.
  loginName        Bytes?    @map("login_name")
  /// The owner's one-line note on the secret, shown with it as the login
  /// name is; encrypted the same way, as "secret:<id>:note".
  note             Bytes?
  /// The TOTP secret whose code goes with this one's sign-in, named with it
  /// wherever its login name is: a text secret's, naming a TOTP one of the
  /// same vault. Unset when that one is deleted.
  totpCompanionId  String?   @map("totp_companion_id")
  totpCompanion    Secret?   @relation("SecretTotpCompanion", fields: [totpCompanionId], references: [id], onDelete: SetNull)
  totpCompanionFor Secret[]  @relation("SecretTotpCompanion")

  authFor        McpServer[]               @relation("ServerAuthSecret")
  authHeaderFor  ServerAuthHeader[]
  oauthClientFor McpServer[]               @relation("ServerOAuthClientSecret")
  oauthTokensFor McpServer[]               @relation("ServerOAuthTokens")
  repos          Repo[]
  browserOrigins SecretBrowserOrigin[]
  allowances     ApiTokenSecretAllowance[]

  @@unique([vaultId, nameKey])
  @@map("secret")
}

/// An origin where the browser may type a secret (lib/core/browser-secrets.ts):
/// the owner's "Always allow" on a page there, or theirs on the secret's
/// row. A secret is typed into a page only at an origin it is bound to, or
/// where the owner allowed it on a request; an API endpoint's use of the
/// secret never counts. Origins are not secret, and are exported.
model SecretBrowserOrigin {
  secretId          String   @map("secret_id")
  secret            Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  /// https://host[:port], as URL.origin writes it: kept as a keyed hash of
  /// it under the vault's key, the origin itself in sealed (#96). A row
  /// from before holds the origin in plain text here and no sealed one.
  origin            String
  /// The origin, AES-256-GCM under the vault's data key with
  /// "secret_browser_origin:<secret id>:<origin hash>" as associated data.
  sealed            Bytes?
  /// The site and its subdomains: an origin at the same scheme and port
  /// whose host ends in this one's, within the same registrable domain
  /// (the public suffix list, browser-secrets.ts). Never another domain.
  includeSubdomains Boolean  @default(false) @map("include_subdomains")
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([secretId, origin])
  @@map("secret_browser_origin")
}

/// Something the gateway can reach on the owner's behalf, with how to
/// authenticate to it: a remote MCP server (Streamable HTTP), an API
/// endpoint or a mail account (see kind).
model McpServer {
  id               String  @id
  vaultId          String  @map("vault_id")
  vault            Vault   @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// Shown to people.
  plainName        String  @map("name")
  /// What an assistant uses to name the server in tool calls (lowercase,
  /// unique within the vault), from before short names were sealed (#96):
  /// "" once sealed into meta, with its keyed hash in slugKey.
  plainSlug        String  @map("slug")
  /// The short name, found by: a keyed hash of it under the vault's key
  /// (keyedHash in lib/core/crypto.ts, label "pcp server slug"). Unique in
  /// the vault; null on a row from before, until the vault's rows are
  /// sealed.
  slugKey          String? @map("slug_key")
  /// What an assistant is told the server is for. Editable, because the
  /// upstream's own description is often missing or written for developers.
  plainDescription String  @default("") @map("description")
  /// mcp: the Streamable HTTP endpoint. openapi: the API's base URL, which
  /// every operation's path is appended to. jmap: the session URL. imap:
  /// imaps://host:port, or imap://host:port for STARTTLS. ssh:
  /// ssh://host:port. caldav: the CalDAV server PCP finds the calendars
  /// from (https://caldav.icloud.com/). browser: the fixed "pcp:browser", which no request is
  /// ever sent to. wrapper: the fixed "pcp:wrapper", likewise. service: the
  /// fixed "pcp:service": where it runs is in service_spec. storage: the
  /// fixed "pcp:storage": where its files are is in storage_root.
  plainUrl         String  @map("url")
  enabled          Boolean @default(true)

  /// none | header | oauth | basic | key (ssh: PCP's own key, in a managed
  /// secret)
  authType          String  @default("none") @map("auth_type")
  /// header auth: the header to send and how the secret goes into it.
  authHeaderName    String? @map("auth_header_name")
  authValueTemplate String? @map("auth_value_template")
  authSecretId      String? @map("auth_secret_id")
  authSecret        Secret? @relation("ServerAuthSecret", fields: [authSecretId], references: [id], onDelete: SetNull)
  /// basic auth: the user name sent with the secret (a JMAP server's Basic
  /// authentication, an IMAP and SMTP login). key: the SSH login.
  plainAuthUsername String? @map("auth_username")

  /// oauth (an MCP server, or a jmap account that signs in with OAuth): an
  /// optional pre-registered client. Without one PCP registers itself
  /// (dynamically, RFC 7591, or with its client metadata document) when the
  /// server allows it.
  plainOauthClientId         String?   @map("oauth_client_id")
  oauthClientSecretId        String?   @map("oauth_client_secret_id")
  oauthClientSecret          Secret?   @relation("ServerOAuthClientSecret", fields: [oauthClientSecretId], references: [id], onDelete: SetNull)
  plainOauthScope            String?   @map("oauth_scope")
  /// oauth: extra parameters for the sign-in address, as a query string
  /// (lib/core/oauth-client.ts), for providers that only hand out a refresh
  /// token, or anything else, when the sign-in asks for it.
  plainOauthAuthorizeParams  String?   @map("oauth_authorize_params")
  /// oauth: the managed secret holding PCP's registration with the server
  /// and, once connected, its token set.
  oauthTokensId              String?   @map("oauth_tokens_id")
  oauthTokens                Secret?   @relation("ServerOAuthTokens", fields: [oauthTokensId], references: [id], onDelete: SetNull)
  /// oauth: when the current token set was obtained; null until connected.
  oauthConnectedAt           DateTime? @map("oauth_connected_at")
  /// openapi + oauth: where the owner signs in and where PCP exchanges the
  /// code and renews the token, from the schema's oauth2 flow as the owner
  /// approved it. MCP servers discover theirs instead.
  plainOauthAuthorizationUrl String?   @map("oauth_authorization_url")
  plainOauthTokenUrl         String?   @map("oauth_token_url")

  /// What the last contact with the server found: unknown | ok |
  /// auth_required | client_required (an OAuth server PCP cannot register
  /// with, waiting for the owner's client) | refused (it turned down the
  /// credentials PCP sent) | error.
  status             String    @default("unknown")
  plainStatusMessage String    @default("") @map("status_message")
  lastSyncedAt       DateTime? @map("last_synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  /// mcp | openapi | jmap | imap | ssh | caldav | browser | wrapper |
  /// service | storage. An openapi
  /// server is an HTTP API described by an OpenAPI schema; its tools are the
  /// schema's operations and PCP calls them directly (lib/core/endpoints.ts).
  /// jmap and imap are mail accounts with a fixed set of mail tools
  /// (lib/core/mail/); ssh is a server PCP runs commands on over SSH
  /// (lib/core/ssh/); caldav is a calendar account, calendars and reminders
  /// over CalDAV with a fixed set of tools (lib/core/caldav/); browser is
  /// the vault's headless browser, with its own
  /// (lib/core/browser/). A wrapper's tools are programs the owner approved
  /// that call the vault's other tools (lib/core/wrappers/). A service is a
  /// container PCP runs with the owner's Docker or Podman on one of their
  /// SSH servers (lib/core/services/), with tools to see and run it. A
  /// storage root is a folder on one of their SSH servers that assistants
  /// read and write files in over SFTP, confined to it (lib/core/storage/).
  kind                 String  @default("mcp")
  /// openapi: where the schema came from, url | upload.
  specSource           String? @map("spec_source")
  /// openapi: the schema's address, when it came from one.
  plainSpecUrl         String? @map("spec_url")
  /// openapi: offer GET operations only. jmap/imap: offer the tools that
  /// read mail only. caldav: the tools that read calendars and reminders.
  /// storage: the tools that read files only.
  readOnly             Boolean @default(false) @map("read_only")
  /// openapi: refuse private, loopback and link-local addresses, for the
  /// schema download and for every call. Set on endpoints an assistant
  /// registers; only the owner can clear it.
  publicOnly           Boolean @default(false) @map("public_only")
  /// openapi: an assistant proposed specUrl and the owner approved the
  /// schema it held then. A background re-read never takes a changed
  /// document from it: the owner re-reads it in PCP, or the assistant asks
  /// for it with update_endpoint while the endpoint is theirs.
  specUrlFromAssistant Boolean @default(false) @map("spec_url_from_assistant")

  /// jmap: what the session document said when it was last read. The API
  /// and download addresses are accepted only on the session URL's origin,
  /// so the credential goes nowhere the owner did not type.
  plainMailApiUrl      String?  @map("mail_api_url")
  plainMailDownloadUrl String?  @map("mail_download_url")
  /// jmap: where attachments to send are uploaded, on the same origin.
  plainMailUploadUrl   String?  @map("mail_upload_url")
  /// jmap: the account the session names for mail.
  plainMailAccountId   String?  @map("mail_account_id")
  /// jmap: whether the server lets this account send (submission).
  mailSubmission       Boolean  @default(false) @map("mail_submission")
  /// imap: where mail is sent, smtps://host:port or smtp://host:port
  /// (STARTTLS), with the same login. Null: the account cannot send.
  plainSmtpUrl         String?  @map("smtp_url")
  /// jmap/imap: the From address when sending, when the user name is not one.
  plainMailFrom        String?  @map("mail_from")
  /// imap: whether PCP files a copy of what it sends in Sent: auto (only
  /// when the mail server did not file one itself), always or never. The
  /// owner's choice; jmap accounts file theirs as the server does.
  mailSaveSent         String   @default("auto") @map("mail_save_sent")
  /// imap: what PCP found out by looking in Sent after a send: the mail
  /// server files its own copy of what it sends (true), it does not
  /// (false), or not known yet (null). Shapes how long the next look waits.
  mailServerFilesSent  Boolean? @map("mail_server_files_sent")

  /// ssh: the public half of PCP's own key for this server, whose private
  /// half is the managed secret in authSecretId. The owner adds it to the
  /// login's authorized_keys.
  plainSshPublicKey String? @map("ssh_public_key")
  /// ssh: the server's host key, "type base64", pinned the first time PCP
  /// completed a key exchange with it. Another key is refused until the
  /// owner forgets this one (lib/core/ssh/hosts.ts).
  plainSshHostKey   String? @map("ssh_host_key")

  /// caldav: the calendar home (RFC 4791 6.2.1) the server named when PCP
  /// last found it from url, where the calendars and reminder lists are.
  /// Taken only on url's origin, or over https:// on a host in the same
  /// domain (iCloud's p<n>-caldav.icloud.com); forgotten when the address
  /// or sign-in changes.
  plainDavHomeUrl String? @map("dav_home_url")

  /// mcp, openapi, wrapper: the version of this item's document in a linked
  /// repository (lib/core/repos/), as last read from or written to one; null
  /// reads as 1. PCP's own edits leave it alone: sync counts it on when it
  /// writes a changed document.
  syncVersion Int? @map("sync_version")

  /// mcp, openapi, wrapper, service: the definition this server is an instance of
  /// (lib/core/definitions.ts). Servers that share one share its
  /// description, schema and edits, wrapper program and tool descriptions;
  /// everything else on this row is the instance's own. Null for the other
  /// kinds, and for a row restored from an older export until it is given
  /// one.
  definitionId  String?           @map("definition_id")
  definition    ServerDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  /// The owner's own note on this server, at most 300 characters on one
  /// line: AES-256-GCM under the vault's data key with "mcp_server:<id>" as
  /// associated data. Assistants read it as the owner's note beside the
  /// description; it is never synced or shared.
  personalNote  Bytes?            @map("personal_note")
  /// Levels and tiers the owner saved with their approval of this server,
  /// as name patterns, for the tools PCP has not read yet (an MCP server
  /// by its address, an OAuth one not yet connected, a service's): JSON
  /// {"tokenId", "rules": [{"pattern", "access"?, "tier"?}]}, applied once
  /// to the tools its first read finds, then cleared
  /// (lib/core/proposed-access.ts). Null when there are none.
  pendingAccess String?           @map("pending_access")

  /// What the server is and where it is, sealed (#96): the JSON of
  /// lib/core/server-meta.ts ServerMeta (name, short name, description, address,
  /// logins, what PCP found out of it, its status message), AES-256-GCM
  /// under the vault's data key with "mcp_server:<id>:meta" as associated
  /// data. Null on a row from before, which holds them in the plain*
  /// columns until the vault's rows are sealed; a sealed row's plain
  /// columns are blank ("" or null).
  meta Bytes?

  tools              McpTool[]
  tokens             ApiTokenServer[]
  oauthStates        OAuthState[]
  toolAccess         ApiTokenToolAccess[]
  sharedToolAccess   VaultToolAccess[]
  toolAllowances     ApiTokenToolAllowance[]
  permissionRequests PermissionRequest[]
  spec               OpenApiSpec?
  wrapperSpec        WrapperSpec?
  serviceSpec        ServiceSpec?            @relation("ServiceOwn")
  servicesHosted     ServiceSpec[]           @relation("ServiceHost")
  registeredBy       ServiceSpec?            @relation("ServiceRegistered")
  storageRoot        StorageRoot?            @relation("StorageOwn")
  storageHosted      StorageRoot[]           @relation("StorageHost")
  storageEntries     StorageEntry[]
  storagePending     StoragePending[]
  authHeaders        ServerAuthHeader[]
  toolResults        ToolResult[]
  repoItems          RepoItem[]
  exits              Exit[]                  @relation("ExitHost")
  exitServices       Exit[]                  @relation("ExitService")
  toolTiers          ToolTier[]

  @@unique([vaultId, slugKey])
  @@index([definitionId])
  @@map("mcp_server")
}

/// What servers that are the same thing share (lib/core/definitions.ts):
/// an MCP server, API endpoint or wrapper as it could be shared, without
/// an address, a secret or anything of the owner's. Its instances (the
/// mcp_server rows that name it) each hold a copy of the shared content
/// (description, schema and edits, wrapper program, tool descriptions),
/// which definitions.ts keeps the same on every one of them: a change to it
/// through any instance is written to all, and each rebuilds its tools.
model ServerDefinition {
  id               String   @id
  vaultId          String   @map("vault_id")
  vault            Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// mcp | openapi | wrapper | service: the kind of every instance.
  kind             String
  /// The definition's own short name, unique in the vault: the first
  /// instance's when it was made. Instances keep their own slugs. From
  /// before short names were sealed (#96): "" once sealed into meta.
  plainSlug        String   @map("slug")
  /// The short name's keyed hash under the vault's key (label "pcp
  /// definition slug"): unique in the vault; null on a row from before.
  slugKey          String?  @map("slug_key")
  /// The name, from before names were sealed (#96): "" once sealed.
  plainName        String   @map("name")
  /// The description every instance carries (mcp_server.description), from
  /// before: "" once sealed.
  plainDescription String   @default("") @map("description")
  /// The name and description, sealed: JSON {"name", "description"},
  /// AES-256-GCM under the vault's data key with
  /// "server_definition:<id>:meta" as associated data. Null on a row from
  /// before, until the vault's rows are sealed.
  meta             Bytes?
  /// The shape of the definition as shared; 1 until a change to it is not
  /// backward compatible.
  formatVersion    Int      @default(1) @map("format_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  instances      McpServer[]
  repoExclusions RepoExclusion[]
  toolTiers      ToolTier[]

  @@unique([vaultId, slugKey])
  @@map("server_definition")
}

/// The owner's tier for a tool (lib/core/tool-tiers.ts): Read, Write or
/// Destructive in place of what its annotations say. Kept apart from
/// mcp_tool so it outlives a tool that drops out of a refresh. A server
/// with a definition keeps it on the definition, shared by every instance
/// (definitionId set); a server without one (mail, calendar, SSH, the
/// browser) on the server (serverId set). Exactly one of the two is set.
model ToolTier {
  id           String            @id
  vaultId      String            @map("vault_id")
  vault        Vault             @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  definitionId String?           @map("definition_id")
  definition   ServerDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  serverId     String?           @map("server_id")
  server       McpServer?        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName     String            @map("tool_name")
  /// read | write | destructive
  tier         String
  /// A wrapper's tool: the tier its calls came to when the owner chose
  /// this one, so the header's bell says when they come to more since.
  seenTier     String?           @map("seen_tier")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([definitionId, toolName])
  @@unique([serverId, toolName])
  @@index([vaultId])
  @@map("tool_tier")
}

/// header auth: a further header carrying a secret, sent with the one on
/// the server row, for a server or API that wants several at once (a key and
/// a secret key, each in its own header). The first header stays on the
/// server row; these follow it in `position` order.
model ServerAuthHeader {
  id            String    @id
  serverId      String    @map("server_id")
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  position      Int
  headerName    String    @map("header_name")
  valueTemplate String    @map("value_template")
  secretId      String?   @map("secret_id")
  secret        Secret?   @relation(fields: [secretId], references: [id], onDelete: SetNull)

  @@unique([serverId, position])
  @@index([secretId])
  @@map("server_auth_header")
}

/// The catalogue of one server's tools, as last read from it. search_tools
/// runs over these rows, so an assistant never needs the full list.
model McpTool {
  id                       String    @id
  serverId                 String    @map("server_id")
  server                   McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The tool's name, from before tool names were sealed (#96): "" once
  /// sealed into about, with its keyed hash in nameKey.
  plainName                String    @map("name")
  /// The name, found by: a keyed hash of the server's id and the name under
  /// the vault's key (keyedHash in lib/core/crypto.ts, label "pcp tool
  /// name"). Unique per server; null on a row from before, until the
  /// vault's rows are sealed.
  nameKey                  String?   @map("name_key")
  /// From before descriptions were sealed (#96): the title, the
  /// description and the owner's wording, the schemas, the call plan and
  /// the outline of an answer, each in its plain column. A sealed row holds
  /// blanks there ("" or null) and its values in about, schema and
  /// override (lib/core/tool-rows.ts).
  plainTitle               String?   @map("title")
  plainDescription         String    @default("") @map("description")
  /// The owner's wording, when the upstream description is not good enough.
  plainDescriptionOverride String?   @map("description_override")
  /// JSON Schema, as JSON text.
  plainInputSchema         String    @map("input_schema")
  /// JSON, when the server sent annotations (readOnlyHint and friends).
  annotations              String?
  /// openapi: the call plan (JSON) that turns the tool's arguments into an
  /// HTTP request. Null for MCP and mail tools.
  plainOperation           String?   @map("operation")
  /// openapi: an outline of what a successful call answers, from the
  /// schema; describe_tool shows it. Null when the schema does not say.
  plainOutput              String?   @map("output")
  /// JSON Schema, as JSON text, of what a successful call answers as
  /// structuredContent, when the tool declares it: an MCP server's
  /// outputSchema, a family tool's (lib/core/tools/family.ts) or a wrapper
  /// tool's. describe shows it as outputSchema.
  plainOutputSchema        String?   @map("output_schema")
  /// The name, title and description, sealed: JSON, AES-256-GCM under the
  /// vault's data key with "mcp_tool:<id>:about" as associated data. What
  /// search and the catalogue read on every request.
  about                    Bytes?
  /// The input and output schemas, the call plan and the outline, sealed
  /// as "mcp_tool:<id>:schema": read when a tool is described or called.
  schema                   Bytes?
  /// The owner's wording, sealed as "mcp_tool:<id>:override".
  override                 Bytes?
  /// JSON: the icons an MCP server gave the tool (MCP's Icon objects).
  icons                    String?
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  @@unique([serverId, nameKey])
  @@map("mcp_tool")
}

/// openapi: the schema an endpoint's tools were generated from, kept apart
/// from the server row so listing servers and serving the gateway never
/// load it. Refreshing an uploaded schema regenerates from this copy.
model OpenApiSpec {
  serverId      String    @id @map("server_id")
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The JSON or YAML text as read, from before schemas were sealed (#96):
  /// "" once sealed in sealedText.
  plainText     String    @map("text")
  /// Edits applied to it before tools are generated: a JSON Patch (RFC
  /// 6902) as JSON (lib/core/openapi/patch.ts), from before: "" once
  /// sealed in sealedPatches.
  plainPatches  String    @default("[]") @map("patches")
  /// The text, sealed: AES-256-GCM under the vault's data key with
  /// "openapi_spec:<server id>:sealedText" as associated data
  /// (lib/core/spec-rows.ts).
  sealedText    Bytes?    @map("sealed_text")
  /// The edits, sealed as "openapi_spec:<server id>:sealedPatches".
  sealedPatches Bytes?    @map("sealed_patches")
  /// A keyed hash of text under the vault's key, hex; a row from before
  /// holds its plain SHA-256 until it is sealed.
  hash          String
  fetchedAt     DateTime  @map("fetched_at")
  /// The PCP_VERSION that built the endpoint's tools from it. A boot under
  /// another version rebuilds them from this copy (endpoints.ts
  /// rebuildOutdatedEndpoints). Null for tools built before it was kept.
  builtWith     String?   @map("built_with")

  @@map("openapi_spec")
}

/// wrapper: what the owner approved, kept apart from the server row like an
/// endpoint's schema. Its tools in the catalogue are built from it
/// (lib/core/wrappers/catalogue.ts), and nothing else changes it but the
/// owner's own save or their answer to a request (lib/core/wrappers/admin.ts).
model WrapperSpec {
  serverId         String    @id @map("server_id")
  server           McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The definition as JSON: each tool's schema, program, the tools it calls
  /// and replaces, and where a secret may go (lib/core/wrappers/definition.ts).
  /// Names a secret by its id, never by its value. From before definitions
  /// were sealed (#96): "" once sealed.
  plainDefinition  String    @map("definition")
  /// The definition, sealed: AES-256-GCM under the vault's data key with
  /// "wrapper_spec:<server id>:sealedDefinition" as associated data.
  sealedDefinition Bytes?    @map("sealed_definition")
  /// A keyed hash of the definition's canonical JSON under the vault's key,
  /// hex: what a request was asked against. A row from before holds its
  /// plain SHA-256 until it is sealed.
  hash             String
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("wrapper_spec")
}

/// service: a container PCP runs with the owner's Docker or Podman engine on
/// one of their SSH servers, through the engine's command line over SSH exec
/// (lib/core/services/). Its own server row (kind "service") carries the
/// tools to see and run it; what it serves is registered as an API endpoint
/// or MCP server of its own (registeredId). Kept apart from the server row
/// like a wrapper's program.
model ServiceSpec {
  serverId         String     @id @map("server_id")
  server           McpServer  @relation("ServiceOwn", fields: [serverId], references: [id], onDelete: Cascade)
  /// What the definition's instances share, as JSON
  /// (lib/core/services/definition.ts): the image by digest, its ports, the
  /// names of its environment variables, its named volumes, the health
  /// check and what it registers. Names no secret and no address. From
  /// before definitions were sealed (#96): "" once sealed.
  plainDefinition  String     @map("definition")
  /// The definition, sealed: AES-256-GCM under the vault's data key with
  /// "service_spec:<server id>:sealedDefinition" as associated data.
  sealedDefinition Bytes?     @map("sealed_definition")
  /// A keyed hash of the definition's canonical JSON under the vault's key,
  /// hex; a row from before holds its plain SHA-256 until it is sealed.
  hash             String
  /// The SSH server the container runs on. Null once that server is
  /// deleted: the container stays there, and PCP no longer reaches it.
  hostId           String?    @map("host_id")
  host             McpServer? @relation("ServiceHost", fields: [hostId], references: [id], onDelete: SetNull)
  /// docker | podman: the engine PCP found on the host.
  engine           String
  /// The engine's version as it reported it, for the owner.
  engineVersion    String     @default("") @map("engine_version")
  /// The container's name on the host: pcp-<name>.
  containerName    String     @map("container_name")
  /// Where the container's ports are published on the host, as JSON:
  /// {"address": "0.0.0.0", "ports": [{"container": 5001, "host": 5001}]}.
  publish          String     @default("{}")
  /// Which secret each environment variable takes, as JSON
  /// {"NAME": "<secret id>"}: by id, never a value. The values reach the
  /// host over standard input only (upstream.ts builds them).
  env              String     @default("{}")
  /// What the owner typed for the definition's plain variables (a VPN
  /// provider's name, a country), as JSON {"NAME": "value"}: no secrets.
  plainValues      String     @default("{}") @map("plain_values")
  /// The API endpoint or MCP server launching it registered; null when it
  /// registers nothing, or once that server is deleted.
  registeredId     String?    @unique @map("registered_id")
  registered       McpServer? @relation("ServiceRegistered", fields: [registeredId], references: [id], onDelete: SetNull)
  /// How PCP reaches what the container publishes: "tunnel", a direct-tcpip
  /// channel through the SSH connection to the address its ports are bound
  /// to on the SSH server (every service launched, updated or made again
  /// since), or "direct", from PCP's machine to the published address (a
  /// service launched before, until then).
  reach            String     @default("direct")
  /// What the owner (or an assistant's stop tool) last asked of it:
  /// "running" or "stopped". A call that finds it down starts it again, and
  /// the reconcile pass brings it back up, only while it is "running".
  intendedState    String     @default("running") @map("intended_state")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([hostId])
  @@map("service_spec")
}

/// storage: a store of files assistants read and write (lib/core/storage/):
/// a folder on one of the owner's SSH servers, reached over SFTP on PCP's
/// own SSH connection (backend "sftp"), or PCP's own store in its data
/// folder (backend "local", one per vault, made by PCP). Every path is
/// checked to stay inside it. A plain store holds the files as they are; an
/// encrypted one holds opaque objects, each sealed under a key of its own,
/// with the names, folders, sizes and times in storage_entry. Its own server
/// row (kind "storage") carries the file tools, so levels, tiers and
/// read-only work as for any server. Only the owner adds or changes one.
/// Kept apart from the server row like a service's spec.
model StorageRoot {
  serverId   String     @id @map("server_id")
  server     McpServer  @relation("StorageOwn", fields: [serverId], references: [id], onDelete: Cascade)
  /// The SSH server the folder is on. Null for the local store, and once
  /// that server is deleted: the folder stays there, and PCP no longer
  /// reaches it.
  hostId     String?    @map("host_id")
  host       McpServer? @relation("StorageHost", fields: [hostId], references: [id], onDelete: SetNull)
  /// The folder, an absolute path on the SSH server ("" for the local
  /// store, which is <data>/storage/<server id>). Every path a tool names
  /// is resolved under it, and refused when its real path is not.
  path       String
  /// Whose files the owner wants these to be (a Samba share's user). SFTP
  /// writes as the SSH login: when this differs, the page says so. Empty is
  /// the login.
  writeAs    String     @default("") @map("write_as")
  /// The umask new files and folders get, as a number (2 is 002): PCP sets
  /// their mode itself, whatever the server's own umask is.
  umask      Int        @default(2)
  /// "sftp" (a folder on the SSH server) or "local" (PCP's data folder).
  backend    String     @default("sftp")
  /// "plain" (files as they are, for other apps too) or "encrypted".
  mode       String     @default("plain")
  /// The store key, random, encrypted under the vault key with
  /// "storage_store:<server id>" as associated data; it wraps each file's
  /// key. Null for a store that was never encrypted.
  storeKey   Bytes?     @map("store_key")
  /// While the owner converts it: "encrypted" or "plain", the mode it is
  /// going to. Tools are refused until it is done.
  converting String     @default("")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([hostId])
  @@map("storage_root")
}

/// The index of an encrypted store: one row per file or folder. The name,
/// size, type and times are in `meta`, encrypted under the vault key with
/// "storage_entry:<id>" as associated data; the content is the object
/// `objectId` on the store's backend, sealed under `fileKey`
/// (lib/core/storage/crypt.ts).
model StorageEntry {
  id          String    @id
  serverId    String    @map("server_id")
  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The folder it is in; "" for the top.
  parentId    String    @default("") @map("parent_id")
  /// A keyed hash of its name in that folder (crypt.ts nameKeyOf), so the
  /// index finds a name and keeps it unique without holding it.
  nameKey     String    @map("name_key")
  folder      Boolean   @default(false)
  /// The sealed object's id on the backend; "" for a folder.
  objectId    String    @default("") @map("object_id")
  /// The file's key, encrypted under the store key with
  /// "storage_object:<server id>:<object id>"; null for a folder.
  fileKey     Bytes?    @map("file_key")
  meta        Bytes
  /// The sealed object's size, what it takes on the backend.
  storedBytes Float     @default(0) @map("stored_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([serverId, parentId, nameKey])
  @@index([serverId, parentId])
  @@map("storage_entry")
}

/// Objects of an encrypted store that may be on its backend with no entry
/// pointing at them: one being written, or one an entry let go of (written
/// again, deleted). Removed with the object once it is gone; one older
/// than the sweep's age is removed by the next request that opens the
/// store, or by the cleanup for the local store. Not exported.
model StoragePending {
  objectId  String    @id @map("object_id")
  serverId  String    @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([serverId, createdAt])
  @@map("storage_pending")
}

/// An OAuth authorization in flight: the state parameter sent to the
/// authorization server and the PKCE verifier to redeem the code with.
model OAuthState {
  id           String    @id
  serverId     String    @map("server_id")
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The PKCE verifier and the discovery result, as encrypted JSON under
  /// the vault's data key.
  codeVerifier Bytes     @map("code_verifier")
  redirectUri  String    @map("redirect_uri")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  @@map("oauth_state")
}

/// Per-vault key/value settings (the public URL, for one).
model Setting {
  vaultId String @map("vault_id")
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  key     String
  value   String

  @@id([vaultId, key])
  @@map("setting")
}

// Settings of the machine PCP runs on rather than of a vault: dynamic DNS and
// HTTPS (lib/core/network/). They are read by background work that runs
// while nobody is signed in, so they are not encrypted, and nothing from a
// vault is ever copied into them. See ARCHITECTURE.md, "Reaching PCP".
model HostSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("host_setting")
}

/// A tool answer too long to hand to an assistant in one piece, kept whole
/// for a day so it can read the rest with read_result
/// (lib/core/tool-results.ts). Only the token whose call produced it can
/// read it.
model ToolResult {
  id         String     @id
  vaultId    String     @map("vault_id")
  vault      Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId    String     @map("token_id")
  token      ApiToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId   String?    @map("server_id")
  server     McpServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  /// The tool it came from, sealed as text (`pcp-sealed:v1:…`, AES-256-GCM
  /// under the vault's data key with "tool_result:<id>:tool"; #96); plain
  /// on a row from before, which is gone within a day.
  toolName   String     @map("tool_name")
  /// text | bytes: what was kept. A text answer, or a file's bytes (an
  /// attachment, a binary field of an answer).
  kind       String     @default("text")
  /// A file's name, when it had one, from before names were sealed (#96):
  /// null on a row written since, which keeps it in sealedName.
  plainName  String?    @map("name")
  /// A file's name, when it had one: AES-256-GCM under the vault's data key
  /// with "tool_result:<id>:name" as associated data.
  sealedName Bytes?     @map("sealed_name")
  /// Any media type, parameters allowed (text/plain, application/json,
  /// text/csv; charset=utf-8, image/png).
  mediaType  String     @map("media_type")
  /// The whole text's length in UTF-16 code units, which offsets count; for
  /// bytes, their number.
  length     Int
  /// The text or the bytes, AES-256-GCM under the vault's data key with
  /// "tool_result:<id>" as associated data.
  ciphertext Bytes
  createdAt  DateTime   @default(now()) @map("created_at")
  expiresAt  DateTime   @map("expires_at")

  @@index([tokenId, createdAt])
  @@index([expiresAt])
  @@map("tool_result")
}

/// A Write or Destructive call a token made (lib/core/calls/guard.ts), kept
/// for the duplicate guard's window so the same call made again is answered
/// with how this one went instead of running twice. Nothing of the
/// arguments is stored but a keyed hash. Not exported; removed by the
/// cleanup once past the longest window.
model CallRecord {
  id         String    @id
  vaultId    String    @map("vault_id")
  vault      Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId    String    @map("token_id")
  token      ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId   String    @map("server_id")
  /// The tool, as a keyed hash of the server's id and its name under the
  /// vault's key (guard.ts recordedTool, #96): compared, never read.
  toolName   String    @map("tool_name")
  /// HMAC-SHA256 of the server id, the tool and the canonical arguments (as
  /// checked and renamed) under a key derived from the vault's data key
  /// (callHash), so the same call compares equal and the column confirms no
  /// guess without the key.
  argsHash   String    @map("args_hash")
  /// write | destructive: the tool's tier when it was called.
  tier       String
  /// running | succeeded | failed | may_have_happened (failed on its way,
  /// so it may have gone through) | asked (the owner was asked: see
  /// requestId)
  status     String
  /// The kept result (tool_result) a long answer already was, by its id.
  resultId   String?   @map("result_id")
  /// A short answer (MAX_INLINE_ANSWER_CHARS), AES-256-GCM under the vault's
  /// data key with "call_record:<id>:answer" as associated data.
  answer     Bytes?
  /// The permission request it made, when it asked the owner.
  requestId  String?   @map("request_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([tokenId, argsHash])
  @@index([tokenId, serverId, toolName, startedAt])
  @@index([startedAt])
  @@map("call_record")
}

/// A cached embedding of one text search ranks (a tool's name and
/// description, a skill, a memory), made by the provider the owner chose on
/// Settings (lib/core/embeddings/). A cache: rebuilt when its text or the
/// provider changes (another hash), never exported, and removed by the
/// cleanup once no search has used it for a while.
model EmbeddingVector {
  id         String   @id
  vaultId    String   @map("vault_id")
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// HMAC-SHA256, under a key derived from the vault's data key, of the
  /// provider and model and the text embedded: what the vector is found by.
  /// Keyed, so it says nothing of the text without the key.
  hash       String
  dimensions Int
  /// The vector (float32, base64), AES-256-GCM under the vault's data key
  /// with "embedding_vector:<id>" as associated data.
  ciphertext Bytes
  createdAt  DateTime @default(now()) @map("created_at")
  /// The last search that used it, to a day: what the cleanup goes by.
  usedAt     DateTime @default(now()) @map("used_at")

  @@unique([vaultId, hash])
  @@index([usedAt])
  @@map("embedding_vector")
}

/// A link that moves one file between PCP and an assistant's own computer
/// (lib/core/file-links.ts): a download of a kept result, or an upload that
/// becomes one. The link's secret is the credential, for this file alone:
/// only its hash is stored, and the file is encrypted under a key derived
/// from it, so neither the row nor the link opens anything else.
model FileLink {
  id           String    @id
  vaultId      String    @map("vault_id")
  vault        Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId      String    @map("token_id")
  token        ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// download | upload | store
  kind         String
  /// SHA-256 of the link's secret, which a request is looked up by.
  secretHash   String    @unique @map("secret_hash")
  /// The kept result a download serves, or the id an upload is kept under.
  resultId     String    @map("result_id")
  /// The file's name from before it was sealed (#96): null on a new row.
  plainName    String?   @map("name")
  /// The file's name, AES-256-GCM under the link's key with
  /// "file_link_name:<id>", so only the link (or the token, through an
  /// upload's wrapped key) shows it. Null for a file with no name.
  sealedName   Bytes?    @map("sealed_name")
  mediaType    String    @map("media_type")
  /// The file's bytes; 0 for an upload that has not arrived.
  length       Int       @default(0)
  /// An upload's link key, wrapped under the vault's data key with
  /// "file_link_key:<id>": what turns the file into a kept result once the
  /// token, holding the vault's key, uses its handle.
  wrappedKey   Bytes?    @map("wrapped_key")
  /// The file, AES-256-GCM under the link's key with "file_link:<id>"; null
  /// for an upload that has not arrived.
  ciphertext   Bytes?
  /// Downloads served, or 1 once an upload arrived.
  uses         Int       @default(0)
  maxUses      Int       @map("max_uses")
  createdAt    DateTime  @default(now()) @map("created_at")
  /// The link works until then; an upload that arrived waits until then to
  /// become a kept result.
  expiresAt    DateTime  @map("expires_at")
  receivedAt   DateTime? @map("received_at")
  /// The upload page this is one file of (UploadLink), or null for a
  /// receive_file link. Not a relation: a file that arrived outlives its
  /// page until the token uses it, and the cleanup removes each by its date.
  uploadLinkId String?   @map("upload_link_id")
  /// A "store" link (share_file): the store whose object it reads with the
  /// file's key alone (PCP's own store, encrypted), or null for a copy made
  /// when it was shared (file_links/ in the data folder). An upload: the
  /// store the file goes to once a request holds the key. Not a relation:
  /// the link ends with the file, which the index says (storage_entry).
  storeId      String?   @map("store_id")
  /// An upload into a store: the folder it goes to, then the file's path
  /// there once saved; AES-256-GCM under the vault's data key with
  /// "file_link_store_path:<id>".
  storePath    Bytes?    @map("store_path")
  /// An upload into a store: when it was saved there.
  deliveredAt  DateTime? @map("delivered_at")
  /// An upload into a store: when the token used its handle (it then is a
  /// kept result too); the row stays until it is saved.
  claimedAt    DateTime? @map("claimed_at")
  /// A "store" link: the sealed object it serves (storage/crypt.ts).
  objectId     String?   @map("object_id")
  /// A "store" link: that object's file key, AES-256-GCM under the link's
  /// key with "file_link_file_key:<id>", so only the link opens it.
  fileKey      Bytes?    @map("file_key")
  /// A "store" link: bytes served so far, ranges counted; it serves
  /// maxUses times the file's size.
  servedBytes  Float     @default(0) @map("served_bytes")

  @@index([tokenId, resultId])
  @@index([expiresAt])
  @@index([uploadLinkId])
  @@map("file_link")
}

/// A page the owner uploads files to (lib/core/upload-links.ts): an
/// assistant with `shareFiles` asks for one with create_upload_link, and the
/// owner opens /upload/<secret> on their phone or computer. The link's secret
/// is the credential. Each file it takes is one of its FileLink rows (kind
/// "upload", `uploadLinkId` set), made with it, each with its result id and
/// its key wrapped under the vault's data key, so the file becomes a kept
/// result once the token uses its handle.
model UploadLink {
  id          String    @id
  vaultId     String    @map("vault_id")
  vault       Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId     String    @map("token_id")
  token       ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// SHA-256 of the link's secret, which the page and its uploads look it up by.
  secretHash  String    @unique @map("secret_hash")
  /// What the files are for, as the assistant said it: AES-256-GCM under the
  /// link's key with "upload_link:<id>", so only the link shows it.
  purpose     Bytes
  maxFiles    Int       @map("max_files")
  /// The result ids its files are kept under, in order: a JSON array.
  resultIds   String    @map("result_ids")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// It takes files until then: its first hour (or less), then a quarter of
  /// an hour from the first file.
  acceptUntil DateTime  @map("accept_until")
  firstAt     DateTime? @map("first_at")
  /// The owner said Done, or it took as many files as it was made for.
  closedAt    DateTime? @map("closed_at")
  /// The row is kept until then, for check_upload: a day past acceptUntil.
  expiresAt   DateTime  @map("expires_at")
  /// Where its files go besides becoming kept results, as the page shows
  /// it ({store, folder} as JSON): AES-256-GCM under the link's key with
  /// "upload_link_destination:<id>"; null for none.
  destination Bytes?
  /// The name of the token that asked, as the page shows it: AES-256-GCM
  /// under the link's key with "upload_link_assistant:<id>", since the page
  /// has no other key (#96). Null on a page from before.
  assistant   Bytes?

  @@index([tokenId])
  @@index([expiresAt])
  @@map("upload_link")
}

/// The browser's sign-ins (lib/core/browser/): the cookies, local storage
/// and IndexedDB of every site the vault's headless browser has visited,
/// as Playwright's storage state. One per vault, kept apart from the
/// browser's server row, which every gateway request reads, and kept when
/// that row is removed, until the owner forgets the sites.
model BrowserProfile {
  vaultId    String   @id @map("vault_id")
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The storage state as JSON, AES-256-GCM under the vault's data key
  /// with "browser_profile:<vaultId>" as associated data.
  ciphertext Bytes
  /// For the Browser page, without decrypting: how many sites and cookies,
  /// and how large the JSON was.
  sites      Int      @default(0)
  cookies    Int      @default(0)
  size       Int      @default(0)
  /// IndexedDB was left out because the whole would not fit.
  partial    Boolean  @default(false)
  savedAt    DateTime @map("saved_at")

  @@map("browser_profile")
}

/// What PCP's authorization server (lib/core/oauth-server/) hands an
/// assistant for an API token made by OAuth sign-in: an authorization code,
/// access tokens and refresh tokens. Each live one wraps the vault's data
/// key in a grant of its own (oauth_code, oauth_access, oauth_refresh), the
/// way an API token does; the database keeps only the SHA-256 of the value.
/// A spent code or refresh token keeps its row, without a grant, until it
/// would have expired: presented again, it ends the token's sign-in.
model OAuthCredential {
  id            String    @id
  vaultId       String    @map("vault_id")
  vault         Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId       String    @map("token_id")
  token         ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// The grant that unwraps the data key; null once spent.
  grantId       String?   @unique @map("grant_id")
  grant         KeyGrant? @relation(fields: [grantId], references: [id], onDelete: Cascade)
  /// code | access | refresh
  kind          String
  /// SHA-256 of the value, kept after it is spent.
  lookupHash    String    @unique @map("lookup_hash")
  clientId      String    @map("client_id")
  /// A code's redirect URI and PKCE challenge (S256), which the exchange
  /// must match.
  redirectUri   String?   @map("redirect_uri")
  codeChallenge String?   @map("code_challenge")
  /// The resource (PCP's /mcp) and scope the sign-in asked for.
  resource      String?
  scope         String?
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([tokenId])
  @@index([expiresAt])
  @@map("oauth_credential")
}

/// A client that registered itself with PCP's authorization server
/// (dynamic client registration, RFC 7591). It belongs to the instance, not
/// to a vault: anyone may register, and a registration opens nothing until
/// the owner approves a sign-in on PCP's page. A client secret is kept only
/// as its SHA-256. Clients that identify themselves with a metadata document
/// (a URL as client_id) have no row: the document is read at each sign-in.
model OAuthClient {
  id           String    @id
  name         String
  /// JSON array of the exact redirect URIs it registered.
  redirectUris String    @map("redirect_uris")
  clientUri    String?   @map("client_uri")
  /// none | client_secret_basic | client_secret_post
  authMethod   String    @map("auth_method")
  secretHash   String?   @map("secret_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  /// The last sign-in approved for it; registrations never used are pruned.
  lastUsedAt   DateTime? @map("last_used_at")

  @@index([createdAt])
  @@map("oauth_client")
}

/// A GitHub repository the owner linked to share skills, wrappers, flows,
/// API endpoints and MCP servers as files (lib/core/repos/). Never a
/// backup: nothing secret goes there.
model Repo {
  id         String   @id
  vaultId    String   @map("vault_id")
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// {owner, name, branch} as JSON, AES-256-GCM under the vault's data key
  /// with "repo:<id>" as associated data: which repository is the owner's
  /// business.
  ciphertext Bytes
  /// trusted | untrusted: whether sync applies a text-only change to a
  /// skill without asking.
  trust      String   @default("untrusted")
  /// read | write: someone else's repository, or one the owner pushes to.
  access     String   @default("read")
  /// How PCP signs in to GitHub for it: a text secret (a personal access
  /// token), or the managed oauth secret of PCP's GitHub sign-in; null for a
  /// public repository read without one.
  secretId   String?  @map("secret_id")
  secret     Secret?  @relation(fields: [secretId], references: [id], onDelete: SetNull)
  /// What GitHub said of it when PCP last asked (linking it, a sync, a
  /// push's review): true private, false public; null not asked yet, which
  /// reads as public wherever that is the careful side.
  private    Boolean?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  items      RepoItem[]
  exclusions RepoExclusion[]

  @@index([vaultId])
  @@map("repo")
}

/// One item of the vault linked to a file or folder in a repository, and
/// how it syncs. Exactly one of skillId and serverId is set, so deleting the
/// item deletes the link.
model RepoItem {
  id            String     @id
  repoId        String     @map("repo_id")
  repo          Repo       @relation(fields: [repoId], references: [id], onDelete: Cascade)
  /// skill | wrapper | flow | endpoint | server
  itemKind      String     @map("item_kind")
  skillId       String?    @unique @map("skill_id")
  skill         Skill?     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  serverId      String?    @unique @map("server_id")
  server        McpServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// {path, remoteSha, localHash, pending, declinedSha, drafts, note} as
  /// JSON, AES-256-GCM under the vault's data key with "repo_item:<id>" as
  /// associated data: where the item is, the hashes sync compares, a change
  /// waiting for the owner (named by its object in the repository, never a
  /// copy of its files) and an assistant's drafts for it.
  ciphertext    Bytes
  /// off | hourly | daily | weekly
  frequency     String     @default("off")
  /// Local changes are pushed too (read-write repositories only).
  bidirectional Boolean    @default(false)
  lastSyncAt    DateTime?  @map("last_sync_at")
  /// ok | review | conflict | local | missing | error
  state         String     @default("ok")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([repoId])
  @@map("repo_item")
}

/// An item the owner keeps out of a linked repository on purpose: a skill,
/// or a server's definition (every instance of it). The repository's page
/// lists it under Excluded, and Include takes it back. Ids only, nothing to
/// encrypt.
model RepoExclusion {
  id           String            @id
  repoId       String            @map("repo_id")
  repo         Repo              @relation(fields: [repoId], references: [id], onDelete: Cascade)
  skillId      String?           @map("skill_id")
  skill        Skill?            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  definitionId String?           @map("definition_id")
  definition   ServerDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now()) @map("created_at")

  @@unique([repoId, skillId])
  @@unique([repoId, definitionId])
  @@map("repo_exclusion")
}
