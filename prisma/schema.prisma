// PCP data model.
//
// Every row that belongs to a person hangs off a Vault. The single-user
// product creates exactly one vault at setup; nothing else in the schema
// assumes that, which is what lets a multi-tenant host reuse it unchanged
// (see ARCHITECTURE.md, "One vault per user").
//
// Nothing sensitive is stored in the clear. Secret values, OAuth tokens and
// the vault's data key itself are AES-256-GCM ciphertext; the key needed to
// read them only ever exists in the memory of a request that presented a
// password, a session cookie or an API token (lib/core/crypto.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Vault {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grants   KeyGrant[]
  sessions Session[]
  tokens   ApiToken[]
  secrets  Secret[]
  servers  McpServer[]
  settings Setting[]

  permissionRequests PermissionRequest[]
  memories           Memory[]
  sharedToolAccess   VaultToolAccess[]
  webFetchRules      WebFetchRule[]
  toolResults        ToolResult[]
  browserProfile     BrowserProfile?

  @@map("vault")
}

/// A copy of the vault's data encryption key, wrapped under a key derived
/// from one credential. `password` and `recovery` grants are the ones a
/// person types; `session` and `api_token` grants are minted for a browser
/// cookie or a bearer token, and a `device` grant for the Mac app's Touch ID
/// key. Deleting a grant revokes that credential.
model KeyGrant {
  id      String @id
  vaultId String @map("vault_id")
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// password | recovery | session | api_token | device
  kind    String
  /// SHA-256 of the credential, for grants looked up by it (everything but
  /// password, of which a vault has exactly one).
  lookupHash String? @unique @map("lookup_hash")
  /// scrypt | hkdf
  kdf       String
  /// JSON: the salt and, for scrypt, its cost parameters.
  kdfParams String @map("kdf_params")
  /// nonce || ciphertext || tag of the wrapped data key.
  wrappedDek Bytes    @map("wrapped_dek")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  session Session?
  token   ApiToken?

  @@index([vaultId, kind])
  @@map("key_grant")
}

model Session {
  id        String   @id
  vaultId   String   @map("vault_id")
  vault     Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  grantId   String   @unique @map("grant_id")
  grant     KeyGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent String?  @map("user_agent")

  @@index([vaultId])
  @@map("session")
}

/// A bearer token an MCP client presents to /mcp. It reaches the servers
/// listed in ApiTokenServer, or every server when allowAllServers is set.
model ApiToken {
  id              String    @id
  vaultId         String    @map("vault_id")
  vault           Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  grantId         String    @unique @map("grant_id")
  grant           KeyGrant  @relation(fields: [grantId], references: [id], onDelete: Cascade)
  name            String
  /// The first characters of the token, so the owner can tell them apart.
  prefix          String
  allowAllServers Boolean   @default(true) @map("allow_all_servers")
  /// Whether the assistant may read and change the API endpoints it set up
  /// through the gateway (get_endpoint, update_endpoint). Registering one is
  /// register_server, which every token may ask for and the owner decides.
  /// Off unless the owner turns it on.
  manageEndpoints Boolean   @default(false) @map("manage_endpoints")
  /// Whether the assistant may keep memories (the gateway's memory tool):
  /// its own, and the shared ones the owner agreed to. Sharing one always
  /// asks the owner. Off unless the owner turns it on.
  keepMemories    Boolean   @default(false) @map("keep_memories")
  /// Whether the assistant may fetch web pages through the gateway
  /// (web_fetch), following the token's site and method levels
  /// (WebFetchRule). Off unless the owner turns it on.
  webFetch        Boolean   @default(false) @map("web_fetch")
  /// Whether the assistant may run programs that call its tools through
  /// the gateway (run_code), each call at the token's own levels. Off
  /// unless the owner turns it on.
  runCode         Boolean   @default(false) @map("run_code")
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime? @map("last_used_at")

  servers            ApiTokenServer[]
  toolAccess         ApiTokenToolAccess[]
  permissionRequests PermissionRequest[]
  memories           Memory[]
  webFetchRules      WebFetchRule[]
  toolResults        ToolResult[]

  @@index([vaultId])
  @@map("api_token")
}

model ApiTokenServer {
  tokenId  String    @map("token_id")
  token    ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId String    @map("server_id")
  server   McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([tokenId, serverId])
  @@map("api_token_server")
}

/// What one token may do with one tool. No row means the tool's level for
/// all tokens (VaultToolAccess), and without one of those the owner is asked
/// first. An `ask` row is only kept while there is a level for all tokens
/// to override. Keyed by tool name, not by the catalogue row, so a tool that
/// drops out of a refresh and comes back keeps its setting.
model ApiTokenToolAccess {
  tokenId   String    @map("token_id")
  token     ApiToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId  String    @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName  String    @map("tool_name")
  /// allowed | ask | blocked
  access    String
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([tokenId, serverId, toolName])
  @@map("api_token_tool_access")
}

/// A tool's level for every token of the vault ("All tokens" on a token's
/// page). A token's own level (ApiTokenToolAccess) wins over it.
model VaultToolAccess {
  vaultId   String    @map("vault_id")
  vault     Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  serverId  String    @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  toolName  String    @map("tool_name")
  /// allowed | ask | blocked
  access    String
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([serverId, toolName])
  @@index([vaultId])
  @@map("vault_tool_access")
}

/// A level web_fetch follows (lib/core/web-fetch.ts): for one HTTP method
/// (the default for sites without a level of their own) or for one site,
/// for one token or for all of them. A token's own rule wins over the one
/// for all tokens, and a site's over a method's.
model WebFetchRule {
  id            String    @id
  vaultId       String    @map("vault_id")
  vault         Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The token it is for; null for a rule for all tokens.
  tokenId       String?   @map("token_id")
  token         ApiToken? @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// The token's id, or "all": what makes a rule unique, since SQLite lets
  /// any number of rows share a null token id.
  scope         String
  /// method | site
  kind          String
  /// A method: GET | POST | PUT | PATCH | DELETE | OTHER. A site: its host,
  /// lower-case, with the port when it is not the scheme's own.
  key           String
  /// allowed | ask | blocked. Null on a site: it follows the method rules.
  access        String?
  /// assistant (first seen in a fetch) | owner (added in PCP)
  addedBy       String    @default("assistant") @map("added_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastFetchedAt DateTime? @map("last_fetched_at")

  @@unique([vaultId, scope, kind, key])
  @@index([tokenId])
  @@map("web_fetch_rule")
}

/// A tool call (or a new server) an assistant asked for that waits for the
/// owner's answer (lib/core/permissions.ts). Answerable for a day; it runs at
/// most once, whichever way the owner answers.
model PermissionRequest {
  id               String     @id
  vaultId          String     @map("vault_id")
  vault            Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId          String     @map("token_id")
  token            ApiToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  /// call | register | memory_share | memory_change | access | endpoint_change
  /// | fetch | browse | browser_handover
  kind             String
  serverId         String?    @map("server_id")
  server           McpServer? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The upstream tool for a call; "register_server" for a new server;
  /// "memory" for a memory to share or a shared one to change;
  /// "propose_tool_access" for tool levels an assistant proposes;
  /// "web_fetch" for a web request.
  toolName         String     @map("tool_name")
  /// The arguments (or the new server's settings) as JSON, AES-256-GCM under
  /// the vault's data key with "permission_request:<id>" as associated data.
  argsCiphertext   Bytes      @map("args_ciphertext")
  /// sha256 of the kind, the target and the canonical arguments, so the same
  /// request asked twice finds the row it already has.
  argsHash         String     @map("args_hash")
  /// call: the parts of the answer the assistant asked for (call_tool's
  /// fields), as a JSON list of paths. Names, never values.
  fields           String?
  /// call: where the assistant asked for base64 text in the answer to be
  /// decoded (call_tool's decode), as a JSON list of paths.
  decode           String?
  /// call: the parts of the answer the assistant asked to be kept as results
  /// and handed back as handles (call_tool's keep), as a JSON list of paths.
  keep             String?
  /// pending | running | executed | failed | declined
  status           String     @default("pending")
  /// Where the owner answered: app | form | url | web
  via              String?
  /// The result text, clipped, encrypted with "permission_request:<id>:result".
  resultCiphertext Bytes?     @map("result_ciphertext")
  resultIsError    Boolean    @default(false) @map("result_is_error")
  createdAt        DateTime   @default(now()) @map("created_at")
  expiresAt        DateTime   @map("expires_at")
  decidedAt        DateTime?  @map("decided_at")

  @@index([tokenId, argsHash])
  @@index([vaultId, status])
  @@index([expiresAt])
  @@map("permission_request")
}

/// A note an assistant keeps for the owner through the gateway's memory
/// tool (lib/core/memories.ts), or one the owner wrote. `private` ones are
/// read only by the token that wrote them; `shared` ones by every token that
/// may keep memories, and an assistant only shares one once the owner agrees.
model Memory {
  id         String    @id
  vaultId    String    @map("vault_id")
  vault      Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The token that wrote it. Null for the owner's own, and once the token
  /// is deleted: the memory stays, it is the owner's.
  tokenId    String?   @map("token_id")
  token      ApiToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  /// assistant | owner
  author     String    @default("assistant")
  /// private | shared
  visibility String    @default("private")
  /// Read in every conversation: its text goes into the gateway's
  /// instructions. Only the owner sets it, and an assistant's change to one
  /// it keeps clears it (memories.ts).
  always     Boolean   @default(false)
  /// The path and the text as JSON, AES-256-GCM under the vault's data key
  /// with "memory:<id>" as associated data.
  ciphertext Bytes
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([vaultId, visibility])
  @@index([tokenId])
  @@map("memory")
}

/// One encrypted value. `text` secrets are entered by the owner; `oauth`
/// secrets hold the token set (and registered client) PCP obtained for an
/// MCP server and are managed by the server that owns them.
model Secret {
  id          String   @id
  vaultId     String   @map("vault_id")
  vault       Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  /// text | oauth
  kind        String   @default("text")
  /// nonce || ciphertext || tag, AES-256-GCM under the vault's data key
  /// with the secret id as associated data.
  ciphertext  Bytes
  keyVersion  Int      @default(1) @map("key_version")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastUsedAt  DateTime? @map("last_used_at")

  authFor       McpServer[] @relation("ServerAuthSecret")
  authHeaderFor ServerAuthHeader[]
  oauthClientFor McpServer[] @relation("ServerOAuthClientSecret")
  oauthTokensFor McpServer[] @relation("ServerOAuthTokens")

  @@unique([vaultId, name])
  @@map("secret")
}

/// Something the gateway can reach on the owner's behalf, with how to
/// authenticate to it: a remote MCP server (Streamable HTTP), an API
/// endpoint or a mail account (see kind).
model McpServer {
  id          String @id
  vaultId     String @map("vault_id")
  vault       Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// Shown to people.
  name        String
  /// What an assistant uses to name the server in tool calls: lowercase,
  /// unique within the vault.
  slug        String
  /// What an assistant is told the server is for. Editable, because the
  /// upstream's own description is often missing or written for developers.
  description String @default("")
  /// mcp: the Streamable HTTP endpoint. openapi: the API's base URL, which
  /// every operation's path is appended to. jmap: the session URL. imap:
  /// imaps://host:port, or imap://host:port for STARTTLS. browser: the
  /// fixed "pcp:browser", which no request is ever sent to.
  url         String
  enabled     Boolean @default(true)

  /// none | header | oauth | basic
  authType String @default("none") @map("auth_type")
  /// header auth: the header to send and how the secret goes into it.
  authHeaderName    String? @map("auth_header_name")
  authValueTemplate String? @map("auth_value_template")
  authSecretId      String? @map("auth_secret_id")
  authSecret        Secret? @relation("ServerAuthSecret", fields: [authSecretId], references: [id], onDelete: SetNull)
  /// basic auth: the user name sent with the secret (a JMAP server's Basic
  /// authentication, an IMAP and SMTP login).
  authUsername      String? @map("auth_username")

  /// oauth (an MCP server, or a jmap account that signs in with OAuth): an
  /// optional pre-registered client. Without one PCP registers itself
  /// (dynamically, RFC 7591, or with its client metadata document) when the
  /// server allows it.
  oauthClientId       String? @map("oauth_client_id")
  oauthClientSecretId String? @map("oauth_client_secret_id")
  oauthClientSecret   Secret? @relation("ServerOAuthClientSecret", fields: [oauthClientSecretId], references: [id], onDelete: SetNull)
  oauthScope          String? @map("oauth_scope")
  /// oauth: extra parameters for the sign-in address, as a query string
  /// (lib/core/oauth-client.ts), for providers that only hand out a refresh
  /// token, or anything else, when the sign-in asks for it.
  oauthAuthorizeParams String? @map("oauth_authorize_params")
  /// oauth: the managed secret holding PCP's registration with the server
  /// and, once connected, its token set.
  oauthTokensId       String? @map("oauth_tokens_id")
  oauthTokens         Secret? @relation("ServerOAuthTokens", fields: [oauthTokensId], references: [id], onDelete: SetNull)
  /// oauth: when the current token set was obtained; null until connected.
  oauthConnectedAt    DateTime? @map("oauth_connected_at")
  /// openapi + oauth: where the owner signs in and where PCP exchanges the
  /// code and renews the token, from the schema's oauth2 flow as the owner
  /// approved it. MCP servers discover theirs instead.
  oauthAuthorizationUrl String? @map("oauth_authorization_url")
  oauthTokenUrl         String? @map("oauth_token_url")

  /// What the last contact with the server found: unknown | ok |
  /// auth_required | client_required (an OAuth server PCP cannot register
  /// with, waiting for the owner's client) | refused (it turned down the
  /// credentials PCP sent) | error.
  status        String    @default("unknown")
  statusMessage String    @default("") @map("status_message")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  /// mcp | openapi | jmap | imap | browser. An openapi server is an HTTP API
  /// described by an OpenAPI schema; its tools are the schema's operations
  /// and PCP calls them directly (lib/core/endpoints.ts). jmap and imap are
  /// mail accounts with a fixed set of mail tools (lib/core/mail/); browser
  /// is the vault's headless browser, with its own (lib/core/browser/).
  kind       String  @default("mcp")
  /// openapi: where the schema came from, url | upload.
  specSource String? @map("spec_source")
  /// openapi: the schema's address, when it came from one.
  specUrl    String? @map("spec_url")
  /// openapi: offer GET operations only. jmap/imap: offer the tools that
  /// read mail only.
  readOnly   Boolean @default(false) @map("read_only")
  /// openapi: refuse private, loopback and link-local addresses, for the
  /// schema download and for every call. Set on endpoints an assistant
  /// registers; only the owner can clear it.
  publicOnly Boolean @default(false) @map("public_only")
  /// openapi: an assistant proposed specUrl and the owner approved the
  /// schema it held then. A background re-read never takes a changed
  /// document from it: the owner re-reads it in PCP, or the assistant asks
  /// for it with update_endpoint while the endpoint is theirs.
  specUrlFromAssistant Boolean @default(false) @map("spec_url_from_assistant")

  /// jmap: what the session document said when it was last read. The API
  /// and download addresses are accepted only on the session URL's origin,
  /// so the credential goes nowhere the owner did not type.
  mailApiUrl      String? @map("mail_api_url")
  mailDownloadUrl String? @map("mail_download_url")
  /// jmap: where attachments to send are uploaded, on the same origin.
  mailUploadUrl   String? @map("mail_upload_url")
  /// jmap: the account the session names for mail.
  mailAccountId   String? @map("mail_account_id")
  /// jmap: whether the server lets this account send (submission).
  mailSubmission  Boolean @default(false) @map("mail_submission")
  /// imap: where mail is sent, smtps://host:port or smtp://host:port
  /// (STARTTLS), with the same login. Null: the account cannot send.
  smtpUrl         String? @map("smtp_url")
  /// jmap/imap: the From address when sending, when the user name is not one.
  mailFrom        String? @map("mail_from")

  tools              McpTool[]
  tokens             ApiTokenServer[]
  oauthStates        OAuthState[]
  toolAccess         ApiTokenToolAccess[]
  sharedToolAccess   VaultToolAccess[]
  permissionRequests PermissionRequest[]
  spec               OpenApiSpec?
  authHeaders        ServerAuthHeader[]
  toolResults        ToolResult[]

  @@unique([vaultId, slug])
  @@map("mcp_server")
}

/// header auth: a further header carrying a secret, sent with the one on
/// the server row, for a server or API that wants several at once (a key and
/// a secret key, each in its own header). The first header stays on the
/// server row; these follow it in `position` order.
model ServerAuthHeader {
  id            String    @id
  serverId      String    @map("server_id")
  server        McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  position      Int
  headerName    String    @map("header_name")
  valueTemplate String    @map("value_template")
  secretId      String?   @map("secret_id")
  secret        Secret?   @relation(fields: [secretId], references: [id], onDelete: SetNull)

  @@unique([serverId, position])
  @@index([secretId])
  @@map("server_auth_header")
}

/// The catalogue of one server's tools, as last read from it. search_tools
/// runs over these rows, so an assistant never needs the full list.
model McpTool {
  id          String    @id
  serverId    String    @map("server_id")
  server      McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name        String
  title       String?
  description String    @default("")
  /// The owner's wording, when the upstream description is not good enough.
  descriptionOverride String? @map("description_override")
  /// JSON Schema, as JSON text.
  inputSchema String    @map("input_schema")
  /// JSON, when the server sent annotations (readOnlyHint and friends).
  annotations String?
  /// openapi: the call plan (JSON) that turns the tool's arguments into an
  /// HTTP request. Null for MCP and mail tools.
  operation   String?
  /// openapi: an outline of what a successful call answers, from the
  /// schema; describe_tool shows it. Null when the schema does not say.
  output      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([serverId, name])
  @@map("mcp_tool")
}

/// openapi: the schema an endpoint's tools were generated from, kept apart
/// from the server row so listing servers and serving the gateway never
/// load it. Refreshing an uploaded schema regenerates from this copy.
model OpenApiSpec {
  serverId  String    @id @map("server_id")
  server    McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The JSON or YAML text as read.
  text      String
  /// Edits applied to it before tools are generated: a JSON Patch (RFC
  /// 6902) as JSON (lib/core/openapi/patch.ts).
  patches   String    @default("[]")
  /// SHA-256 of text, hex.
  hash      String
  fetchedAt DateTime  @map("fetched_at")
  /// The PCP_VERSION that built the endpoint's tools from it. A boot under
  /// another version rebuilds them from this copy (endpoints.ts
  /// rebuildOutdatedEndpoints). Null for tools built before it was kept.
  builtWith String?   @map("built_with")

  @@map("openapi_spec")
}

/// An OAuth authorization in flight: the state parameter sent to the
/// authorization server and the PKCE verifier to redeem the code with.
model OAuthState {
  id           String    @id
  serverId     String    @map("server_id")
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The PKCE verifier and the discovery result, as encrypted JSON under
  /// the vault's data key.
  codeVerifier Bytes     @map("code_verifier")
  redirectUri  String    @map("redirect_uri")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  @@map("oauth_state")
}

/// Per-vault key/value settings (the public URL, for one).
model Setting {
  vaultId String @map("vault_id")
  vault   Vault  @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  key     String
  value   String

  @@id([vaultId, key])
  @@map("setting")
}

// Settings of the machine PCP runs on rather than of a vault: dynamic DNS and
// HTTPS (lib/core/network/). They are read by background work that runs
// while nobody is signed in, so they are not encrypted, and nothing from a
// vault is ever copied into them. See ARCHITECTURE.md, "Reaching PCP".
model HostSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("host_setting")
}

/// A tool answer too long to hand to an assistant in one piece, kept whole
/// for a day so it can read the rest with read_result
/// (lib/core/tool-results.ts). Only the token whose call produced it can
/// read it.
model ToolResult {
  id         String     @id
  vaultId    String     @map("vault_id")
  vault      Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  tokenId    String     @map("token_id")
  token      ApiToken   @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  serverId   String?    @map("server_id")
  server     McpServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  toolName   String     @map("tool_name")
  /// text | bytes: what was kept. A text answer, or a file's bytes (an
  /// attachment, a binary field of an answer).
  kind       String     @default("text")
  /// A file's name, when it had one.
  name       String?
  /// Any media type, parameters allowed (text/plain, application/json,
  /// text/csv; charset=utf-8, image/png).
  mediaType  String     @map("media_type")
  /// The whole text's length in UTF-16 code units, which offsets count; for
  /// bytes, their number.
  length     Int
  /// The text or the bytes, AES-256-GCM under the vault's data key with
  /// "tool_result:<id>" as associated data.
  ciphertext Bytes
  createdAt  DateTime   @default(now()) @map("created_at")
  expiresAt  DateTime   @map("expires_at")

  @@index([tokenId, createdAt])
  @@index([expiresAt])
  @@map("tool_result")
}

/// The browser's sign-ins (lib/core/browser/): the cookies, local storage
/// and IndexedDB of every site the vault's headless browser has visited,
/// as Playwright's storage state. One per vault, kept apart from the
/// browser's server row, which every gateway request reads, and kept when
/// that row is removed, until the owner forgets the sites.
model BrowserProfile {
  vaultId    String   @id @map("vault_id")
  vault      Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  /// The storage state as JSON, AES-256-GCM under the vault's data key
  /// with "browser_profile:<vaultId>" as associated data.
  ciphertext Bytes
  /// For the Browser page, without decrypting: how many sites and cookies,
  /// and how large the JSON was.
  sites      Int      @default(0)
  cookies    Int      @default(0)
  size       Int      @default(0)
  /// IndexedDB was left out because the whole would not fit.
  partial    Boolean  @default(false)
  savedAt    DateTime @map("saved_at")

  @@map("browser_profile")
}
