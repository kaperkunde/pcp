{
  "name": "pcp",
  "version": "0.5.1",
  "private": true,
  "description": "Self-hosted, single-user MCP gateway with an encrypted secret store and a search-based tool endpoint.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/scripts/reset.mjs && pnpm test:e2e:build && playwright test",
    "test:e2e:build": "PCP_TEST_BUILD=1 next build --webpack",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prepare": "husky",
    "test:e2e:reset": "node e2e/scripts/reset.mjs",
    "version:bump": "node scripts/version.mjs bump"
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.5",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@kaperkunde/backoff": "^0.1.0",
    "@kaperkunde/mcp": "0.2.1",
    "@kaperkunde/next-kit": "0.1.2",
    "@kaperkunde/pcpgg-protocol": "0.1.2",
    "@kaperkunde/security": "0.5.0",
    "@kaperkunde/ui": "0.2.2",
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "acme-client": "^5.4.0",
    "better-sqlite3": "^12.11.1",
    "fast-xml-parser": "^5.12.0",
    "ical.js": "2.2.1",
    "imapflow": "^2.11.0",
    "js-yaml": "5.5.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0",
    "patchright-core": "1.63.0",
    "prisma": "7.10.1",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "ssh2": "^1.17.0",
    "tldts": "^7.4.28",
    "turndown": "^7.2.5",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kaperkunde/config": "0.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "prettier": "@kaperkunde/config/prettier"
}
