# PCP needs no environment variables. Everything is configured in the web UI
# after the first visit. These are optional overrides.

# Where the database and logs live. Default: ./data (the Docker image sets
# /data and mounts a volume there).
#PCP_DATA_DIR=./data

# The port the server listens on. Default: 3000.
#PORT=3000

# HTTPS (off until turned on under Settings): the ports PCP's own listeners
# use for plain HTTP (Let's Encrypt's check and the redirect) and HTTPS.
# Default: 80 and 443, which need root outside Docker; the Docker image sets
# 8080 and 8443 and the compose file maps 80 and 443 onto them.
#PCP_HTTP_PORT=80
#PCP_HTTPS_PORT=443

# The ACME directory certificates come from. Default: Let's Encrypt.
# Let's Encrypt's staging directory, for trying things out:
#PCP_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Dynamic DNS: a service that answers with this network's public IPv4
# address as plain text. Default: api.ipify.org, then two others.
#PCP_PUBLIC_IP_URL=https://api.ipify.org
