# PCP needs no environment variables. Everything is configured in the web UI
# after the first visit. These two are optional overrides.

# Where the database and logs live. Default: ./data (the Docker image sets
# /data and mounts a volume there).
#PCP_DATA_DIR=./data

# The port the server listens on. Default: 3000.
#PORT=3000

# The address it listens on. Default: every interface (the desktop app sets
# 127.0.0.1 until you let other devices connect).
#HOSTNAME=127.0.0.1
